@inherits LayoutComponentBase
@inject IPWAUpdaterService PWAUpdaterService

<PageTitle>BlazorServerPWA1</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
        
        <div style="text-align: center; margin-bottom: 12px;">
            <button class="btn btn-primary btn-sm" @onclick="OnCheckForUpdateAsync">
                CHECK FOR UPDATE
            </button>
        </div>
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://docs.microsoft.com/aspnet/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task OnCheckForUpdateAsync()
    {
        await PWAUpdaterService.CheckForUpdateAsync();
    }
}
